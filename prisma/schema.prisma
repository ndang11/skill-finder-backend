datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  customer
  professional
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  username  String   @unique
  fullname  String
  password  String
  role      Role     @default(customer)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}